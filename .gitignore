
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Media binaries live in the S3 assets bucket, not git (decision sand-a55.4 / y0u.1).
# Manifests (media.json) are tracked; the files beside them are a local staging copy only.
content/shared/media/**/*.png
content/shared/media/**/*.jpg
content/shared/media/**/*.jpeg
content/shared/media/**/*.webp
content/shared/media/**/*.avif
content/shared/media/**/*.tif
content/shared/media/**/*.tiff
# WebP/AVIF derivatives made by `npm run media` (uploaded to the assets bucket)
content/shared/media/**/.derived/

# Score masters live beside their cue.json as a local staging copy only; the
# derivatives go to the assets bucket (decision 0008). Neither belongs in git —
# a WAV master is tens of megabytes and nothing in the browser wants one.
content/shared/audio/**/*.wav
content/shared/audio/**/*.aif
content/shared/audio/**/*.aiff
content/shared/audio/**/*.flac
content/shared/audio/**/*.mp3
content/shared/audio/**/*.m4a
content/shared/audio/**/*.opus
content/shared/audio/**/*.ogg
# Opus/AAC derivatives made by `npm run audio`
content/shared/audio/**/.derived/

# Agent worktrees (local only)
.claude/worktrees/

# bd append-only audit log — local, machine-specific; history lives in Dolt
.beads/interactions.jsonl

# macOS
.DS_Store

# Node / build
node_modules/
# ...and as a bare entry too: a trailing slash matches only directories, so a
# symlink named node_modules (as a worktree may use) would otherwise be
# committable — and was committed once, in #69.
node_modules
dist/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example

# Local staging copy of the assets bucket (served from /assets/* in production)
public/assets/

# CDK
infra/cdk.out/
infra/cdk.context.json

# Screenshots from scripts/visual-review.mjs (docs/design-review.md) — regenerate, never commit
visual-review/

# Screenshots + report.json from scripts/visual-check.mjs (ADR 0011) — a CI
# artifact and a local convenience; the baseline that is committed is the JSON
# beside the script, never the pixels
visual-check/
