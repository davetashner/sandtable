{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/tracks.schema.json",
  "title": "Sandtable tracks",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
      },
      "person": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "person:<slug> — the commander this track belongs to"
      },
      "kind": {
        "type": "string",
        "enum": [
          "hq",
          "journey"
        ],
        "description": "hq: the headquarters he commanded from, day by day. journey: the man himself, at documented hours"
      },
      "post": {
        "description": "The headquarters, for an hq track",
        "type": "string",
        "minLength": 1
      },
      "postShort": {
        "description": "The headquarters in a word, for the map token: OHL, GQG, Paris",
        "type": "string",
        "minLength": 1,
        "maxLength": 16
      },
      "side": {
        "description": "Side id, for the ring colour; inferred from the post otherwise",
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "waypoints": {
        "minItems": 2,
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
            },
            {
              "description": "How good this one position is — high: documented; medium: inferred from sources; low: approximate; contested: the sources disagree. Omit to inherit the route’s or track’s confidence",
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low",
                "contested"
              ]
            }
          ],
          "description": "[lng, lat, ISO time, confidence?]"
        },
        "description": "Strictly increasing in time"
      },
      "confidence": {
        "default": "medium",
        "description": "How good the positions on this path are — high: documented; medium: inferred from sources; low: approximate; contested: historians disagree. Every waypoint inherits it unless it carries one of its own",
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "contested"
        ]
      },
      "mode": {
        "description": "How he travelled, where the sources say: Joffre and Hentsch by car (motor), a headquarters moving by train (rail). Absent is not a claim that he walked — the pace check reads an unmarked track as road travel",
        "type": "string",
        "enum": [
          "march",
          "motor",
          "rail",
          "sea",
          "air"
        ]
      },
      "derivation": {
        "type": "string",
        "minLength": 1,
        "description": "How the positions were derived, and at what resolution"
      },
      "notes": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "Citations supporting the claims in this entity"
      }
    },
    "required": [
      "id",
      "person",
      "kind",
      "waypoints",
      "confidence",
      "derivation",
      "sources"
    ],
    "additionalProperties": false
  }
}
