{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/historiography.schema.json",
  "title": "Sandtable historiography",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "question": {
        "type": "string",
        "minLength": 1,
        "description": "The dispute stated as a question, not as a finding"
      },
      "positions": {
        "minItems": 2,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "“The charge”, “The defence”, “The correction”"
            },
            "who": {
              "type": "string",
              "minLength": 1,
              "description": "Who argues it — named, so the reader can weigh it"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "description": "The argument as its holders would put it, with footnotes"
            }
          },
          "required": [
            "label",
            "who",
            "summary"
          ],
          "additionalProperties": false
        },
        "description": "At least two: a card that carries one position is a verdict in costume"
      },
      "settled": {
        "description": "What is *not* in dispute",
        "type": "string",
        "minLength": 1
      },
      "unread": {
        "description": "The evidence that would settle it, and why it is unread",
        "type": "string",
        "minLength": 1
      },
      "links": {
        "type": "object",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "formations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "places": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "battles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "tech": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "science": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "casualties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "historiography": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          }
        },
        "additionalProperties": false,
        "description": "Related entities by id; every id must resolve"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "Citations supporting the claims in this entity"
      }
    },
    "required": [
      "id",
      "title",
      "question",
      "positions",
      "sources"
    ],
    "additionalProperties": false
  }
}
