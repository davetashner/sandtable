{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/tech.schema.json",
  "title": "Sandtable tech",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "field": {
        "type": "string",
        "enum": [
          "railways",
          "artillery",
          "small-arms",
          "machine-guns",
          "aviation",
          "signals",
          "naval",
          "armour",
          "chemistry",
          "medicine",
          "motor-transport",
          "fortification",
          "industry-logistics",
          "other"
        ]
      },
      "introduced": {
        "type": "object",
        "properties": {
          "at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
              },
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "ISO-8601 date, e.g. 1914-08-04"
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "Year or year-month, e.g. 1891 or 1914-08"
              }
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "description": "When it mattered: at = timeline glyph position, label = human text"
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "description": "The card’s first paragraph"
      },
      "body": {
        "type": "string",
        "minLength": 1,
        "description": "Markdown"
      },
      "counter": {
        "description": "The counter-innovation it provoked (tech-tree edge), as a TechCard id",
        "type": "string"
      },
      "media": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
          "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
        }
      },
      "links": {
        "type": "object",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "formations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "places": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "battles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "tech": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "science": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "casualties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          }
        },
        "additionalProperties": false,
        "description": "Related entities by id; every id must resolve"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "Citations supporting the claims in this entity"
      }
    },
    "required": [
      "id",
      "title",
      "field",
      "introduced",
      "summary",
      "sources"
    ],
    "additionalProperties": false
  }
}
