{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/formations.schema.json",
  "title": "Sandtable formations",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "\"German 1st Army\""
      },
      "short": {
        "description": "Token label: \"1. Armee\", \"BEF\"",
        "type": "string",
        "minLength": 1,
        "maxLength": 16
      },
      "side": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "One of pack.sides[].id"
      },
      "kind": {
        "type": "string",
        "enum": [
          "army-group",
          "army",
          "corps",
          "division",
          "brigade",
          "regiment",
          "detachment",
          "garrison",
          "fleet",
          "squadron",
          "flotilla",
          "other"
        ]
      },
      "commander": {
        "description": "person:<slug>",
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
      },
      "parent": {
