            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
          },
          {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "ISO-8601 date, e.g. 1914-08-04"
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
            "description": "Year or year-month, e.g. 1891 or 1914-08"
          }
        ]
      },
      "concentration": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string",
            "minLength": 1,
            "description": "In words: \"Aachen–Jülich, behind the Dutch frontier\""
          },
          "position": {
            "description": "Representative point for the start token",
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ]
          },
          "asOf": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
              },
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "ISO-8601 date, e.g. 1914-08-04"
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "Year or year-month, e.g. 1891 or 1914-08"
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                  "description": "Source id, e.g. source:herwig-2009"
                },
                "pages": {
                  "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                  "type": "string"
                },
                "note": {
                  "description": "What this citation supports",
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "description": "Citations supporting the claims in this entity"
          }
        },
        "required": [
          "area"
        ],
        "additionalProperties": false
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "description": "Markdown"
      },
      "media": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
          "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
        }
      },
      "plates": {
        "type": "object",
        "properties": {
          "axis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "What is being compared, in one line: \"German kit, August 1914\" — short, because it renders as an eyebrow over the set"
          },
          "fit": {
            "description": "One crop for every plate in the set (ADR 0012 fits), default band. A shared frame is the control variable; `contain` is not offered here",
            "type": "string",
            "enum": [
              "band",
              "portrait"
            ]
          },
          "items": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "media": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                  "description": "media:<kind>/<slug>/<file-stem>"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48,
                  "description": "This plate’s point on the axis: \"Pickelhaube\", \"Belgium\""
                }
              },
              "required": [
                "media",
                "label"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "axis",
          "items"
        ],
        "additionalProperties": false,
        "description": "A bounded comparison set of photographs on one axis (ADR 0014)"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "Citations supporting the claims in this entity"
      }
    },
    "required": [
      "id",
      "name",
      "side",
      "kind"
    ],
    "additionalProperties": false
  }
