{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/formations.schema.json",
  "title": "Sandtable formations",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "\"German 1st Army\""
      },
      "short": {
        "description": "Token label: \"1. Armee\", \"BEF\"",
        "type": "string",
        "minLength": 1,
        "maxLength": 16
      },
      "side": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "One of pack.sides[].id"
      },
      "kind": {
        "type": "string",
        "enum": [
          "army-group",
          "army",
          "corps",
          "division",
          "brigade",
          "regiment",
          "detachment",
          "garrison",
          "fleet",
          "squadron",
          "flotilla",
          "other"
        ]
      },
      "commander": {
        "description": "person:<slug>",
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
      },
      "parent": {
        "description": "Higher formation in this pack",
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
      },
      "strength": {
        "type": "object",
        "properties": {
          "men": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "guns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "asOf": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
              },
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "ISO-8601 date, e.g. 1914-08-04"
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                "description": "Year or year-month, e.g. 1891 or 1914-08"
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                  "description": "Source id, e.g. source:herwig-2009"
                },
                "pages": {
                  "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                  "type": "string"
                },
                "note": {
                  "description": "What this citation supports",
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "description": "Citations supporting the claims in this entity"
          }
        },
        "additionalProperties": false
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "description": "Markdown"
      },
      "media": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
          "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
        }
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "Citations supporting the claims in this entity"
      }
    },
    "required": [
      "id",
      "name",
      "side",
      "kind"
    ],
    "additionalProperties": false
  }
}
