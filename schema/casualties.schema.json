{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/casualties.schema.json",
  "title": "Sandtable casualties",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "<era>:casualties-<slug>"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "timeRange": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false,
        "description": "The battle, day or period the figures cover"
      },
      "battle": {
        "description": "Battle the record belongs to",
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
      },
      "event": {
        "description": "Event the record belongs to",
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
      },
      "place": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
      },
      "figures": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "side": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "description": "One of pack.sides[].id"
            },
            "category": {
              "type": "string",
              "enum": [
                "killed",
                "wounded",
                "missing",
                "prisoners",
                "casualties"
              ],
              "description": "casualties = killed + wounded + missing (+ prisoners) where the source gives only a total"
            },
            "value": {
              "description": "Point estimate",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "low": {
              "description": "Lower bound of a range",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "high": {
              "description": "Upper bound of a range",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low",
                "contested"
              ],
              "description": "high: documented; medium: inferred from sources; low: approximate; contested: historians disagree"
            },
            "note": {
              "description": "What the figure counts, and who gives it",
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                    "description": "Source id, e.g. source:herwig-2009"
                  },
                  "pages": {
                    "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                    "type": "string"
                  },
                  "note": {
                    "description": "What this citation supports",
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              "description": "Citations supporting the claims in this entity"
            }
          },
          "required": [
            "side",
            "category",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "summary": {
        "description": "What happened to people, footnoted [^slug] to `sources`",
        "type": "string",
        "minLength": 1
      },
      "historiography": {
        "description": "Why the figures differ, who gives what",
        "type": "string",
        "minLength": 1
      },
      "links": {
        "type": "object",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "formations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "places": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "battles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "tech": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "science": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "casualties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            }
          }
        },
        "additionalProperties": false,
        "description": "Related entities by id; every id must resolve"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "Citations supporting the claims in this entity"
      }
    },
    "required": [
      "id",
      "title",
      "timeRange",
      "figures",
      "sources"
    ],
    "additionalProperties": false
  }
}
