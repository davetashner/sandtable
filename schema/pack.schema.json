{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/pack.schema.json",
  "title": "Sandtable pack",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
      "description": "<era>:pack, e.g. 1914:schlieffen-marne"
    },
    "idPrefix": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Era prefix every entity id in this pack carries, e.g. \"1914\""
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Markdown"
    },
    "timeRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "description": "The campaign clock: the timeline spans this range"
    },
    "region": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "description": "Geographic extent of the pack; west > east crosses the antimeridian (a Pacific theatre)"
    },
    "borderYear": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Which shared/geo/borders/<year>.geojson to draw"
    },
    "tiles": {
      "description": "Basemap archive this campaign is drawn on, by name — \"central-pacific-z10\", never a URL (content/shared/geo/tiles/manifest.json, ADR 0002); omit for the Central-Europe default",
      "type": "string",
      "enum": [
        "central-europe-z10",
        "world-z6",
        "eastern-europe-z10",
        "east-asia-z10",
        "central-pacific-z10",
        "sw-pacific-z10",
        "philippines-z10",
        "oahu-z13",
        "midway-z13",
        "guadalcanal-z13",
        "betio-z14",
        "peleliu-z14",
        "iwo-jima-z14",
        "okinawa-z13",
        "port-arthur-z14"
      ]
    },
    "frontLine": {
      "description": "Shared front-line series to draw as the clock moves, e.g. \"western-front\" (content/shared/geo/front/<name>.geojson, sand-g80.1); omit for none",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "camera": {
      "type": "object",
      "properties": {
        "center": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "description": "[lng, lat] in WGS 84"
        },
        "zoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 22
        },
        "bearing": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "pitch": {
          "type": "number",
          "minimum": 0,
          "maximum": 85
        }
      },
      "required": [
        "center",
        "zoom"
      ],
      "additionalProperties": false,
      "description": "Opening camera"
    },
    "sides": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Short side id used by formations: de, fr, be, gb, ru"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "short": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "alliance": {
            "description": "\"Central Powers\" / \"Entente\" — drives the colour family",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "branches": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
            "description": "<era>:<slug>; the historical branch is conventionally <era>:historical"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "historical",
              "counterfactual"
            ]
          },
          "divergesAt": {
            "description": "Required for counterfactual branches: shared history before this instant",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "Markdown"
          },
          "historiography": {
            "description": "The debate: who argues what about whether this could have happened",
            "type": "string",
            "minLength": 1
          },
          "feasibility": {
            "description": "For \"success\" branches: what would have had to be true",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "condition": {
                  "type": "string",
                  "minLength": 1
                },
                "met": {
                  "type": "boolean",
                  "description": "Was the condition actually met in history?"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Markdown"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                        "description": "Source id, e.g. source:herwig-2009"
                      },
                      "pages": {
                        "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                        "type": "string"
                      },
                      "note": {
                        "description": "What this citation supports",
                        "type": "string"
                      }
                    },
                    "required": [
                      "source"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Citations supporting the claims in this entity"
                }
              },
              "required": [
                "condition",
                "met"
              ],
              "additionalProperties": false
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                  "description": "Source id, e.g. source:herwig-2009"
                },
                "pages": {
                  "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                  "type": "string"
                },
                "note": {
                  "description": "What this citation supports",
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "description": "Citations supporting the claims in this entity"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "defaultBranch": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
      "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
    },
    "language": {
      "default": "en",
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "draft",
        "review",
        "published"
      ],
      "description": "seed: scaffolding; draft: being authored; review: in fact-check; published"
    },
    "sources": {
      "description": "General bibliography for the pack",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
            "description": "Source id, e.g. source:herwig-2009"
          },
          "pages": {
            "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
            "type": "string"
          },
          "note": {
            "description": "What this citation supports",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      }
    },
    "pace": {
      "description": "How fast this era’s technology moved, per mode, where it differs from the 1914 default (ADR 0020); omit a mode to keep the default",
      "type": "object",
      "properties": {
        "march": {
          "type": "object",
          "properties": {
            "sustained": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode held day after day in this era — above it, a warning"
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode could not beat on any leg in this era — above it, an error"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "What these are the speeds of, in words: \"US fast carrier task force, 25–33 knots economical to flank\""
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                    "description": "Source id, e.g. source:herwig-2009"
                  },
                  "pages": {
                    "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                    "type": "string"
                  },
                  "note": {
                    "description": "What this citation supports",
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              "description": "Where the numbers come from; at least one citation"
            }
          },
          "required": [
            "sustained",
            "limit",
            "note",
            "sources"
          ],
          "additionalProperties": false
        },
        "motor": {
          "type": "object",
          "properties": {
            "sustained": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode held day after day in this era — above it, a warning"
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode could not beat on any leg in this era — above it, an error"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "What these are the speeds of, in words: \"US fast carrier task force, 25–33 knots economical to flank\""
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                    "description": "Source id, e.g. source:herwig-2009"
                  },
                  "pages": {
                    "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                    "type": "string"
                  },
                  "note": {
                    "description": "What this citation supports",
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              "description": "Where the numbers come from; at least one citation"
            }
          },
          "required": [
            "sustained",
            "limit",
            "note",
            "sources"
          ],
          "additionalProperties": false
        },
        "rail": {
          "type": "object",
          "properties": {
            "sustained": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode held day after day in this era — above it, a warning"
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode could not beat on any leg in this era — above it, an error"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "What these are the speeds of, in words: \"US fast carrier task force, 25–33 knots economical to flank\""
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                    "description": "Source id, e.g. source:herwig-2009"
                  },
                  "pages": {
                    "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                    "type": "string"
                  },
                  "note": {
                    "description": "What this citation supports",
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              "description": "Where the numbers come from; at least one citation"
            }
          },
          "required": [
            "sustained",
            "limit",
            "note",
            "sources"
          ],
          "additionalProperties": false
        },
        "sea": {
          "type": "object",
          "properties": {
            "sustained": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode held day after day in this era — above it, a warning"
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode could not beat on any leg in this era — above it, an error"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "What these are the speeds of, in words: \"US fast carrier task force, 25–33 knots economical to flank\""
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                    "description": "Source id, e.g. source:herwig-2009"
                  },
                  "pages": {
                    "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                    "type": "string"
                  },
                  "note": {
                    "description": "What this citation supports",
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              "description": "Where the numbers come from; at least one citation"
            }
          },
          "required": [
            "sustained",
            "limit",
            "note",
            "sources"
          ],
          "additionalProperties": false
        },
        "air": {
          "type": "object",
          "properties": {
            "sustained": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode held day after day in this era — above it, a warning"
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "km/h this mode could not beat on any leg in this era — above it, an error"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "What these are the speeds of, in words: \"US fast carrier task force, 25–33 knots economical to flank\""
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                    "description": "Source id, e.g. source:herwig-2009"
                  },
                  "pages": {
                    "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                    "type": "string"
                  },
