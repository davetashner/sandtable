            "sources"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "opening": {
      "description": "The first thirty seconds (sand-1l0.26)",
      "type": "object",
      "properties": {
        "eyebrow": {
          "description": "Mono eyebrow above the premise",
          "type": "string",
          "minLength": 1
        },
        "headline": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The premise, one line per beat of the reveal"
        },
        "lede": {
          "type": "string",
          "minLength": 1,
          "description": "One or two sentences under the headline"
        },
        "camera": {
          "description": "Where the map settles while the premise is read",
          "type": "object",
          "properties": {
            "center": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "description": "[lng, lat] in WGS 84"
            },
            "zoom": {
              "type": "number",
              "minimum": 0,
              "maximum": 22
            },
            "bearing": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "pitch": {
              "type": "number",
              "minimum": 0,
              "maximum": 85
            }
          },
          "required": [
            "center",
            "zoom"
          ],
          "additionalProperties": false
        },
        "claim": {
          "description": "One click from the premise to the evidence behind it",
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "\"Where does “forty days” come from?\""
            },
            "card": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Card that shows the working — typically a clock"
            }
          },
          "required": [
            "label",
            "card"
          ],
          "additionalProperties": false
        },
        "chain": {
          "description": "Where the pack’s backstory lives (sand-1l0.32)",
          "type": "object",
          "properties": {
            "label": {
              "description": "\"How did it start?\"",
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "description": "Sub-label: \"the chain of events\"",
              "type": "string",
              "minLength": 1
            },
            "focus": {
              "description": "Chapter or zoom-in the backstory establishes itself in: the map goes there, so a chain that begins somewhere other than the campaign front is seen where it happened",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
            },
            "card": {
              "description": "Card to open — typically the first link of the chain",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
            }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                "description": "Source id, e.g. source:herwig-2009"
              },
              "pages": {
                "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                "type": "string"
              },
              "note": {
                "description": "What this citation supports",
                "type": "string"
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          },
          "description": "Citations supporting the claims in this entity"
        }
      },
      "required": [
        "headline",
        "lede"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "idPrefix",
    "title",
    "summary",
    "timeRange",
    "region",
    "borderYear",
    "camera",
    "sides",
    "branches",
    "defaultBranch",
    "status"
  ],
  "additionalProperties": false
}
