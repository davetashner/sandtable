{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/tours.schema.json",
  "title": "Sandtable tours",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "<era>:tour-<slug>"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "description": "One or two sentences: what the tour shows and roughly how long"
      },
      "steps": {
        "minItems": 2,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "description": "Unique within the tour; the URL carries it as ?step=<id>"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "narration": {
              "type": "string",
              "minLength": 1,
              "description": "A few sentences, footnoted [^slug] to the tour’s sources"
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "Where the clock stands when the step opens"
            },
            "playUntil": {
              "description": "Play the clock from `at` to here, then advance; absent: hold at `at`",
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "speed": {
              "description": "Simulated ms per real second while this step plays",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "hold": {
              "description": "Seconds to hold a non-playing step before advancing",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "camera": {
              "description": "Fly here; absent: the battle region when `focus` is set, else the pack region",
              "type": "object",
              "properties": {
                "center": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "description": "[lng, lat] in WGS 84"
                },
                "zoom": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 22
                },
                "bearing": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "pitch": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 85
                }
              },
              "required": [
                "center",
                "zoom"
              ],
              "additionalProperties": false
            },
            "focus": {
              "description": "Battle to be zoomed into; absent: the campaign map",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
            },
            "branch": {
              "description": "Branch to show; absent: the pack default",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
            },
            "card": {
              "description": "Dossier card to open on arrival",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$"
            }
          },
          "required": [
            "id",
            "title",
            "narration",
            "at"
          ],
          "additionalProperties": false
        }
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "At least one citation; footnote slugs in every step’s narration must name these"
      }
    },
    "required": [
      "id",
      "title",
      "summary",
      "steps",
      "sources"
    ],
    "additionalProperties": false
  }
}
