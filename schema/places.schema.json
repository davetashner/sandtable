{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/places.schema.json",
  "title": "Sandtable places",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "place:<slug>"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Name used in the narrative (usually the period name)"
      },
      "names": {
        "description": "Period and modern names: Port Arthur / Lüshun",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "description": "BCP 47 tag, e.g. de, fr, zh-Latn",
              "type": "string"
            },
            "period": {
              "description": "When this name applied, e.g. \"to 1918\" or \"1905–1945\"",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "period",
                "modern",
                "translation",
                "transliteration",
                "nickname"
              ]
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "kind": {
        "type": "string",
        "enum": [
          "city",
          "town",
          "village",
          "fortress",
          "river",
          "region",
          "sea",
          "strait",
          "forest",
          "other"
        ]
      },
      "lngLat": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        ],
        "description": "[lng, lat] in WGS 84"
      },
      "country": {
        "description": "State in 1914 (or the pack era), e.g. \"Belgium\"",
        "type": "string"
      },
      "notes": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "Citations supporting the claims in this entity"
      }
    },
    "required": [
      "id",
      "name",
      "kind",
      "lngLat"
    ],
    "additionalProperties": false
  }
}
