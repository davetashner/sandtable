{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/people.schema.json",
  "title": "Sandtable people",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "person:<slug>"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "sortName": {
        "description": "\"Moltke, Helmuth von (the Younger)\"",
        "type": "string"
      },
      "names": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "description": "BCP 47 tag, e.g. de, fr, zh-Latn",
              "type": "string"
            },
            "period": {
              "description": "When this name applied, e.g. \"to 1918\" or \"1905–1945\"",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "period",
                "modern",
                "translation",
                "transliteration",
                "nickname"
              ]
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "born": {
        "type": "string",
        "format": "date",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
        "description": "ISO-8601 date, e.g. 1914-08-04"
      },
      "died": {
        "type": "string",
        "format": "date",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
        "description": "ISO-8601 date, e.g. 1914-08-04"
      },
      "nationality": {
        "description": "The 1914 state, ISO 3166-1 alpha-2 where one exists (DE, FR, GB, BE, RU) and the historical code where it does not: AT-HU is Austria-Hungary, which is not AT — Franz Ferdinand and the Bosnian Serb who shot him were subjects of the same empire",
        "type": "string"
      },
      "roles": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "e.g. \"Commander, German 1st Army\""
            },
            "from": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
                },
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                  "description": "ISO-8601 date, e.g. 1914-08-04"
                },
                {
                  "type": "string",
                  "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                  "description": "Year or year-month, e.g. 1891 or 1914-08"
                }
              ]
            },
            "to": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
                },
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                  "description": "ISO-8601 date, e.g. 1914-08-04"
                },
                {
                  "type": "string",
                  "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$",
                  "description": "Year or year-month, e.g. 1891 or 1914-08"
                }
              ]
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        }
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "description": "One paragraph, era-neutral"
      },
      "media": {
        "description": "Portrait media ids",
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
          "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
        }
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "Citations supporting the claims in this entity"
      }
    },
    "required": [
      "id",
      "name",
      "summary"
    ],
    "additionalProperties": false
  }
}
