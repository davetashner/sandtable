{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandtable.davetashner.com/schema/tallies.schema.json",
  "title": "Sandtable tallies",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
        "description": "<era>:tally-<slug>"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "subtitle": {
        "type": "string"
      },
      "unit": {
        "type": "string",
        "minLength": 1,
        "description": "\"corps\", \"divisions\", \"men\"…"
      },
      "start": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "asOf": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "description": "Markdown"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                  "description": "Source id, e.g. source:herwig-2009"
                },
                "pages": {
                  "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                  "type": "string"
                },
                "note": {
                  "description": "What this citation supports",
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "description": "Citations supporting the claims in this entity"
          }
        },
        "required": [
          "value",
          "asOf"
        ],
        "additionalProperties": false
      },
      "entries": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "ISO-8601 date-time with offset, e.g. 1914-08-04T08:00:00Z"
            },
            "delta": {
              "type": "number",
              "description": "Negative when strength leaves"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "formations": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
              }
            },
            "place": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Qualified entity id, e.g. 1914:marne or person:joffre-joseph"
            },
            "lngLat": {
              "description": "Where the marker goes on the map",
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "Markdown"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                    "description": "Source id, e.g. source:herwig-2009"
                  },
                  "pages": {
                    "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                    "type": "string"
                  },
                  "note": {
                    "description": "What this citation supports",
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              "description": "Citations supporting the claims in this entity"
            }
          },
          "required": [
            "id",
            "at",
            "delta",
            "label"
          ],
          "additionalProperties": false
        }
      },
      "comparisons": {
        "description": "Named a:b comparisons drawn as paired bars",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "a": {
              "type": "number",
              "description": "Left-hand quantity, e.g. the right wing"
            },
            "b": {
              "type": "number",
              "description": "Right-hand quantity, e.g. the left wing"
            },
            "unit": {
              "type": "string"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "Markdown"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
                    "description": "Source id, e.g. source:herwig-2009"
                  },
                  "pages": {
                    "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
                    "type": "string"
                  },
                  "note": {
                    "description": "What this citation supports",
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              "description": "Citations supporting the claims in this entity"
            }
          },
          "required": [
            "id",
            "label",
            "a",
            "b"
          ],
          "additionalProperties": false
        }
      },
      "summary": {
        "description": "Footnoted [^slug] to `sources`",
        "type": "string",
        "minLength": 1
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$",
              "description": "Source id, e.g. source:herwig-2009"
            },
            "pages": {
              "description": "Page(s), e.g. \"112–115\" or \"ch. 4\"",
              "type": "string"
            },
            "note": {
              "description": "What this citation supports",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "description": "Citations supporting the claims in this entity"
      }
    },
    "required": [
      "id",
      "title",
      "unit",
      "start",
      "entries",
      "sources"
    ],
    "additionalProperties": false
  }
}
