{
  "name": "sandtable",
  "version": "0.1.0",
  "description": "Interactive history simulation — the Schlieffen Plan and beyond",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "bash scripts/check-content.sh && tsx scripts/build-front.ts --check && tsx scripts/validate-content.ts",
    "visual:check": "node scripts/visual-check.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "perf": "node scripts/perf-measure.mjs",
    "visual:review": "node scripts/visual-review.mjs",
    "schema": "tsx scripts/generate-schema.ts",
    "borders": "tsx scripts/fetch-borders.ts",
    "front": "tsx scripts/build-front.ts",
    "tokens": "tsx scripts/generate-tokens.ts",
    "media": "tsx scripts/media-pipeline.ts",
    "audio": "tsx scripts/audio-pipeline.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/extensions": "^9.3.10",
    "@deck.gl/geo-layers": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/mapbox": "^9.3.10",
    "maplibre-gl": "^6.5.0",
    "pmtiles": "^4.5.0",
    "protomaps-themes-base": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "mapshaper": "^0.7.55",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "sharp": "^0.34.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
